# Database (Docker internal network - uses service name 'db')
DATABASE_URL="postgresql://postgres:postgres@db:5432/remote_puppet?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=remote_puppet

# JWT
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5174"

# TURN Server (must be reachable from clients outside Docker - use your host IP, not Docker service name)
TURN_SERVER_URL="turn:<YOUR_HOST_IP>:3478"
TURN_SERVER_USERNAME="turnuser"
TURN_SERVER_CREDENTIAL="turnpassword"
TURN_SECRET="change-this-to-a-secure-random-string"
